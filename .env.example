# Example placeholders only. Match the user/password to your PostgreSQL service.
DATABASE_URL=postgresql://firstsports:CHANGE_ME@127.0.0.1:5432/firstsports?schema=public
TEST_DATABASE_URL=postgresql://firstsports:CHANGE_ME@127.0.0.1:5432/firstsports_test?schema=public
E2E_DATABASE_URL=postgresql://firstsports:CHANGE_ME@127.0.0.1:5432/firstsports_e2e_test?schema=public
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Generate separately with openssl rand -hex 32; never use example keys.
DOCUMENT_HMAC_KEY=
CRON_SECRET=
BRASPRESS_USERNAME=
BRASPRESS_PASSWORD=
ALFA_API_KEY=
# Braspress: API v3 byNf. Alfa: API v1.2. Endpoints fixed to official hosts in server code.

# Correios CWS credentials. Never expose these with NEXT_PUBLIC_.
CORREIOS_USERNAME=
CORREIOS_ACCESS_CODE=
CORREIOS_POSTING_CARD=
# production or homologacao; production is the default.
CORREIOS_ENVIRONMENT=production

# Icaro ESL Cloud: token de CLIENTE, somente no servidor.
ICARO_API_TOKEN=
